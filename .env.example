# ────────────────────────────────────────────────────────────────────────────
# MobiGear — Environment Variable Template
#
# DO NOT put real secrets in this file.
# Copy this to .env.local (ignored by Git) and fill in the real values.
# See supabase/README-STAGE2.md for step-by-step setup instructions.
# ────────────────────────────────────────────────────────────────────────────

# ── Stage 1 ───────────────────────────────────────────────────────────────────
# Deprecated in Stage 2: the WhatsApp number is now stored in store_settings.
# Kept here for reference; remove after confirming Stage 2 migration works.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Stage 2 (Supabase) ────────────────────────────────────────────────────────
# Project URL — safe to expose to the browser (NEXT_PUBLIC_ prefix)
# Found in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — designed for browser use; database RLS still applies.
# Found in: Supabase dashboard → Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Auth UUID for the single store owner (server-only; not a password).
# Must match the UUID inserted into public.owners in the Supabase SQL editor.
OWNER_USER_ID=

# ── Future (optional) ─────────────────────────────────────────────────────────
# Vercel automatically sets NEXT_PUBLIC_VERCEL_URL in deployed environments.
# Not needed locally.
# NEXT_PUBLIC_VERCEL_URL=
